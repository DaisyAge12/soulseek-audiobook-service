# Copy this file to .env and replace all CHANGE_ME values locally.
# Never commit the resulting .env file.

# Image pulled by docker compose (compose file uses image: ${SAS_IMAGE})
SAS_IMAGE=ghcr.io/daisyage12/soulseek-audiobook-service:latest
SAS_PORT=8099

# Authentication (SAS_API_KEY must be at least 16 characters)
SAS_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

# slskd
# Use host.docker.internal if slskd runs on the Docker Desktop host,
# or http://slskd:5030 if it is a container on a shared network.
SLSKD_URL=http://host.docker.internal:5030
SLSKD_API_KEY=CHANGE_ME_USE_A_DEDICATED_KEY
SLSKD_URL_BASE=
SLSKD_VERIFY_SSL=true

# Host paths mounted by Docker Compose (Windows example: D:/Media/slskd)
SLSKD_DOWNLOAD_PATH=CHANGE_ME_HOST_PATH_TO_SLSKD_DOWNLOADS
COMPLETED_AUDIOBOOKS_PATH=CHANGE_ME_HOST_PATH_TO_COMPLETED_AUDIOBOOKS

# AudioBookRequest (ABR) polling integration
ABR_ENABLED=true
ABR_URL=http://audiobookrequest:8000
ABR_API_KEY=CHANGE_ME_USE_A_DEDICATED_KEY
ABR_POLL_INTERVAL_SECONDS=60
ABR_TIMEOUT_SECONDS=30
ABR_VERIFY_SSL=true
ABR_IMPORT_STANDARD_REQUESTS=true
ABR_IMPORT_MANUAL_REQUESTS=true
ABR_AUTO_MARK_DOWNLOADED=true
ABR_CALLBACK_FAILURE_FATAL=false

# Search and download behaviour
SEARCH_CANDIDATES_PER_QUERY=5
SEARCH_INCLUDE_AUDIOBOOK_VARIANT=true
SEARCH_INCLUDE_TITLE_ONLY_VARIANT=true
SEARCH_TIMEOUT_SECONDS=45
SEARCH_RESPONSE_LIMIT=100
MAX_ATTEMPTS_PER_CANDIDATE=3
MAX_CANDIDATES=5
MIN_CANDIDATE_SCORE=25
TRANSFER_POLL_SECONDS=10
STALL_TIMEOUT_SECONDS=900
CANDIDATE_TIMEOUT_SECONDS=21600
WORKER_POLL_SECONDS=2

# Recovery: treat a transfer as cancelled if it disappears from slskd this long
MISSING_TRANSFER_GRACE_SECONDS=45

# Post-download move
ENABLE_POST_DOWNLOAD_MOVE=true
MOVE_OPTIONAL_FILES=true

# Duplicates
DUPLICATE_DETECTION_ENABLED=true
DUPLICATE_POLICY=skip
# complete: create a job with status=duplicate
# reject: return HTTP 409
DUPLICATE_POLICY_ON_REQUEST=complete

# No-match handling
NO_MATCH_NOTIFY_ENABLED=true
NO_MATCH_RETRY_ENABLED=true
# Seconds between retries: 21600 = 6 hours, 86400 = 24 hours
NO_MATCH_RETRY_INTERVAL_SECONDS=86400
# 0 = retry forever
NO_MATCH_RETRY_MAX=0

# Discord notifications
DISCORD_NOTIFY_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_DELAY_SECONDS=180

# Logging
LOG_LEVEL=INFO
