# Copy this file to .env and replace all CHANGE_ME values locally.
# Never commit the resulting .env file.

SAS_IMAGE=ghcr.io/your-github-user/soulseek-audiobook-service:latest
SAS_PORT=8099

# Authentication and service integration
SAS_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=CHANGE_ME_USE_A_DEDICATED_KEY

# Audiobookshelf Request integration
ABR_URL=http://host.docker.internal:8000
ABR_API_KEY=CHANGE_ME_USE_A_DEDICATED_KEY

# Host paths mounted by Docker Compose
SLSKD_DOWNLOAD_PATH=/absolute/host/path/to/downloads
COMPLETED_AUDIOBOOKS_PATH=/absolute/host/path/to/completed-audiobooks

# Optional application settings. Confirm names against app/config.py.
DATABASE_PATH=/data/sas.db
LOG_FILE=/logs/sas.log
LOG_LEVEL=INFO
DOWNLOAD_ROOT=/downloads
COMPLETED_AUDIOBOOKS_ROOT=/completed-audiobooks
